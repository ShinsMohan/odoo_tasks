<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="CustomPivotViewButtons" t-inherit="web.PivotView.Buttons" t-inherit-mode="extension">
        <xpath expr="//button[@class='btn btn-secondary fa fa-download o_pivot_download']" position="after">
            <button class="btn btn-secondary o_pivot_custom_excel" t-on-click="downloadCustomExcel" data-tooltip="Invoice in Spreadsheet" aria-label="Invoice in Spreadsheet" t-attf-disabled="{{noDataDisplayed ? 'disabled' : false}}">
                <span>Invoice in Spreadsheet</span>
            </button>
        </xpath>
    </t>

</templates>